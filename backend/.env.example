# DueDateHQ backend — copy to backend/.env.local and fill in.
# In production these are set via `fly secrets set ...` (NEVER on disk).

# ----- Postgres (Supabase) -----
# Use the POOLED connection string from Supabase → Settings → Database
# → Connection pooling → URI. Critical: use port 6543 (PgBouncer), not 5432.
# Drizzle migrations work fine through the pooler.
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ----- Supabase admin (server-side only) -----
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Server -----
PORT=8080
NODE_ENV=development
# CORS — set to your Vercel frontend URL in production. `*` in dev only.
CORS_ORIGIN=http://localhost:5173
