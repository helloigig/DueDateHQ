# DueDateHQ frontend — copy to .env.local and fill in.
# Vite only exposes vars prefixed with VITE_ to client code.

# ----- Mock vs. real API toggle -----
# When `true`, all tRPC calls dispatch to src/lib/api/mock-adapter.ts.
# When `false`, calls go to VITE_API_URL via httpBatchLink.
VITE_USE_MOCK_API=false

# ----- Backend API (Hono + tRPC on Fly.io) -----
# Path is /trpc, set in src/lib/api/client.ts. Don't include the trailing /trpc here.
VITE_API_URL=http://localhost:3001

# ----- Supabase (auth + storage + realtime) -----
# These are PUBLIC keys — safe to ship to the browser. The service-role key
# stays on the backend; do NOT add it here.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ----- Static assets CDN (firm logos, exports) -----
VITE_PUBLIC_ASSETS_URL=https://assets.duedatehq.com

# ----- Observability (optional) -----
VITE_SENTRY_DSN=

# ----- Dev quality of life -----
# Enables React Query Devtools in production preview builds.
VITE_ENABLE_DEV_TOOLS=true
